# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/auto_image_processor"

# Authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# Redis (for BullMQ job queue)
REDIS_URL="redis://localhost:6379"

# Storage - Choose one provider
STORAGE_PROVIDER="local" # local | supabase | s3

# Local storage
UPLOAD_DIR="./uploads"
PUBLIC_URL="http://localhost:3000"

# Supabase (optional)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_BUCKET_ORIGINALS="originals"
SUPABASE_BUCKET_PROCESSED="processed"

# AWS S3 (optional)
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="your-bucket-name"

# AI Processing - Choose providers
# Background Removal
REMOVE_BG_API_KEY="your-removebg-key" # https://www.remove.bg/api

# OpenAI (for image enhancement via DALL-E)
OPENAI_API_KEY="your-openai-key"
OPENAI_MODEL="dall-e-3"

# Replicate (alternative for Stable Diffusion)
REPLICATE_API_TOKEN="your-replicate-token"

# Google Cloud Vision (for OCR / plate reading)
GOOGLE_CLOUD_API_KEY="your-google-cloud-key"

# Plate Recognizer (specialized plate OCR)
PLATE_RECOGNIZER_API_KEY="your-plate-recognizer-key"

# App Config
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="AutoVision Pro"
NODE_ENV="development"
MAX_UPLOAD_SIZE_MB="50"
MAX_BATCH_SIZE="200"
